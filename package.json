{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --port=3000 --host=127.0.0.1",
    "dev:test": "node ./node_modules/vite/bin/vite.js --mode tenant-test --port=3010 --strictPort --host=127.0.0.1",
    "dev:auth-test": "node --import tsx server/authSandbox.ts",
    "demo": "node --import tsx server/demo.ts",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "server": "node --import tsx server/index.ts",
    "auth:email-maintenance": "node --import tsx server/emailMaintenance.ts",
    "auth:email-maintenance:test": "node --import tsx server/emailMaintenance.ts --tenant-test",
    "clean": "rm -rf dist server.js",
    "lint": "node ./node_modules/typescript/bin/tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.5.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
