# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Dossiers de vente (serveur uniquement). Renseigner le service autorisé de votre entreprise.
TMS_SALES_CONNECTOR=seller
# URL complète de recherche, terminée par /seller/searchDossierVente pour Seller.
TMS_SALES_API_URL=
TMS_SALES_API_TOKEN=

# Messagerie du serveur habituel. URL canonique de la plateforme, HTTPS en production.
TMS_PUBLIC_URL=
TMS_SMTP_HOST=
TMS_SMTP_PORT=587
TMS_SMTP_SECURE=false
TMS_SMTP_USER=
TMS_SMTP_PASS=
TMS_SMTP_FROM=
# Première création uniquement : 32 octets aléatoires en hexadécimal (64 caractères).
# Clé privée du responsable serveur, jamais une variable VITE_. La retirer après activation.
TMS_SETUP_SECRET=
# Secours exceptionnel hors interface, désactivé par défaut. Voir docs/GMAIL_AUTH.md.
TMS_ALLOW_EMAIL_REBIND=false
# Migration d’une base habituelle existante : autorisation exceptionnelle après sauvegarde.
TMS_ALLOW_AUTH_MIGRATION=false

# Mode tenant-test uniquement. Décommenter dans .env pour utiliser Mailpit sur la machine locale.
# TMS_TEST_PUBLIC_URL=http://127.0.0.1:3010
# TMS_TEST_SMTP_HOST=127.0.0.1
# TMS_TEST_SMTP_PORT=1025
# TMS_TEST_SMTP_SECURE=false
# TMS_TEST_SMTP_FROM=tms@example.test
# TMS_TEST_SMTP_USER=
# TMS_TEST_SMTP_PASS=
# TMS_TEST_SETUP_SECRET=
# TMS_TEST_ALLOW_EMAIL_REBIND=false
